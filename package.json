{
  "name": "portfolio-reworked",
  "version": "1.0.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "update-packages": "npx npm-check-updates -u && npm install",
    "patch": "npm run update-packages && npm version patch && git push --follow-tags",
